# Ferrox Enterprise SaaS Backend Environment Configuration

# Server
FERROX_PORT=8080
FERROX_ENV=development

# Security & PASETO v4 Symmetric Key (32 bytes minimum)
FERROX_JWT_SECRET=super_secret_ferrox_paseto_key_32_bytes!!

# Database Engine: 'sql' (PostgreSQL) or 'nosql' (MongoDB)
FERROX_DB_ENGINE=sql
DATABASE_URL=postgres://postgres:ferrox_secret@localhost:5432/ferrox_saas

# Redis (Caching & Job Queue)
REDIS_URL=redis://127.0.0.1:6379

# Observability & Error Tracking
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
