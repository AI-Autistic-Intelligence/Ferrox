# Multi-stage Docker build for Client Target Application Node
FROM rust:1.75-slim as builder
WORKDIR /usr/src/ferrox

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps ./apps

RUN cargo build --release -p ferrox-saas-backend

FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/ferrox/target/release/ferrox-saas-backend /app/ferrox-client-node

ENV SERVER_PORT=8080
ENV RUST_LOG=info
EXPOSE 8080

CMD ["/app/ferrox-client-node"]
